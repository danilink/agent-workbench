{
  "permissions": {
    "allow": [
      "Bash(sbt *)",
      "Bash(npm run *)",
      "Bash(npm --prefix frontend run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose *)"
    ],
    "deny": ["Read(./.env)", "Read(./**/.env)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.mjs" }]
      }
    ]
  }
}
